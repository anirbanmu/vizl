{
  "name": "@vizl/server",
  "version": "1.0.0",
  "description": "Vizl server package - Hono backend for SoundCloud API proxy",
  "main": "dist/server.bundle.cjs",
  "type": "module",
  "scripts": {
    "dev": "node --env-file=../../.env.local --import tsx/esm --watch src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --target=node22 --format=cjs --outfile=dist/server.bundle.cjs",
    "start": "node --env-file=../../.env.local dist/server.bundle.cjs",
    "check": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write . --ignore-path ../../.prettierignore",
    "format:check": "prettier --check . --ignore-path ../../.prettierignore"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "esbuild": "^0.28.2",
    "tsx": "^4.23.12"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "hono": "^4.13.5",
    "ky": "^2.0.2",
    "supports-color": "^11.0.0"
  }
}
